rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Stores collection (Store configuration & geofencing center)
    match /stores/{storeId} {
      allow read, write: if true;
    }

    // Products collection (Inventory with carton-to-unit conversion)
    match /products/{productId} {
      allow read, write: if true;
    }

    // Transactions collection (POS and Client PWA checkouts)
    match /transactions/{transactionId} {
      allow read, write: if true;

      // Line items subcollection
      match /items/{itemId} {
        allow read, write: if true;
      }
    }

    // Fraud logs (Preventive AI forensic logs)
    match /fraud_logs/{logId} {
      allow read, write: if true;
    }

    // Restock recommendations (AI Restock Advisor)
    match /restock_recommendations/{recId} {
      allow read, write: if true;
    }

    // Financial snapshots
    match /financial_snapshots/{snapshotId} {
      allow read, write: if true;
    }

    // Users and customers collection
    match /users/{userId} {
      allow read, write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Demo seed collection
    match /seed/{seedId} {
      allow read, write: if true;
    }

    // Fallback for demo environment
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

