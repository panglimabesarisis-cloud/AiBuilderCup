rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Stores collection & all nested subcollections
    match /stores/{storeId} {
      allow read, write: if true;

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Products collection (Inventory with carton-to-unit conversion)
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Stock movements collection
    match /stock_movements/{movementId} {
      allow read, write: if true;
    }

    // Transactions collection (POS and Client PWA checkouts)
    match /transactions/{transactionId} {
      allow read, write: if true;

      // Line items subcollection
      match /items/{itemId} {
        allow read, write: if true;
      }

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Fraud logs (Preventive AI forensic logs)
    match /fraud_logs/{logId} {
      allow read, write: if true;
    }

    // Restock recommendations (AI Restock Advisor)
    match /restock_recommendations/{recId} {
      allow read, write: if true;
    }

    // Financial snapshots
    match /financial_snapshots/{snapshotId} {
      allow read, write: if true;
    }

    // Users and customers collection
    match /users/{userId} {
      allow read, write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Demo seed and meta collections
    match /seed/{seedId} {
      allow read, write: if true;
    }

    match /meta/{metaId} {
      allow read, write: if true;
    }

    // AI Agents and Execution Logs
    match /ai_agents/{agentId} {
      allow read, write: if true;
    }

    match /ai_logs/{logId} {
      allow read, write: if true;
    }

    // Catch-all for any other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
