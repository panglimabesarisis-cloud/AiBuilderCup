# ===== WAJIB =====
# Dari Google AI Studio / Google Cloud
GEMINI_API_KEY=
# Token Fonnte BARU. Token lama tertulis di server.ts dan ClientPwaApp.tsx (ikut ke bundle browser): anggap bocor dan ganti di dashboard Fonnte.
FONNTE_TOKEN=

# ===== OPSIONAL =====
# Nama model Gemini. Cek valid lewat GET /api/health dan satu panggilan AI nyata.
GEMINI_MODEL=gemini-3.8-flash
# String acak 32+ karakter supaya OTP tetap valid setelah server restart
OTP_SECRET=
# true = kode OTP ikut dikembalikan di response (khusus demo tanpa Fonnte). JANGAN true di produksi.
OTP_DEMO_ECHO=false
# true = halaman AI Anti-Fraud boleh mengirim velocityCount sendiri (slider sandbox). Hanya untuk demo juri.
# Frontend Inspector harus menambah "sandbox: true" di payload.
ALLOW_FRAUD_SANDBOX=false

# Lokasi toko untuk geofence (single-tenant demo). Ganti dengan koordinat toko asli.
STORE_LAT=-6.2088
STORE_LNG=106.8456
GEOFENCE_RADIUS_M=500
# Akurasi GPS maksimum yang diterima (meter). Akurasi <1 m tidak realistis di browser; 20-50 lebih masuk akal.
MAX_GPS_ACCURACY_M=50

# Ambang keputusan anti-fraud: skor >= REVIEW butuh persetujuan admin, >= REJECT ditolak
FRAUD_REVIEW_SCORE=45
FRAUD_REJECT_SCORE=85

# Target stok restock = minStockAlert x angka ini
RESTOCK_TARGET_MULTIPLIER=2
